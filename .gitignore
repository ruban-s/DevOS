# Dependencies — never commit an installed tree. The root package.json holds
# typecheck devDependencies only (nothing ships: PAYLOAD in Tools/lib.ts is an
# allowlist). bun.lock IS committed on purpose — CI runs --frozen-lockfile, so
# an unpinned typechecker would let CI go red with no change to this repo.
node_modules/
bun.lockb

# Secrets — env-var names in repo, values never
.env
.env.*
!.env.example
*.pem
*.key

# Harness runtime state (generated; system of record is the ISA + git)
DEVOS/MEMORY/
MEMORY/
checkpoints.jsonl
checkpoint-state.json
work.json
doctor.json

# Browser verification captures (may contain authenticated pages)
interceptor-screenshot-*
interceptor-capture-*
interceptor-macos-screenshot-*

# Local harness/machine config (per-machine, never shared)
.claude/
.opencode/


# OS + editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
temp/
